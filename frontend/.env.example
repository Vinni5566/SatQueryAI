# Clerk (required for sign-in / sign-up)
# Dashboard: https://dashboard.clerk.com → API Keys → Publishable key
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxx

# SatQuery Python API (GeoTIFF preview + chat sessions)
VITE_API_URL=http://127.0.0.1:8000

# In Clerk Dashboard → Configure → Paths (or Domains):
#   Sign-in URL:  http://localhost:5173/sign-in
#   Sign-up URL:  http://localhost:5173/sign-up
#   After sign-in: http://localhost:5173/
#   After sign-up: http://localhost:5173/
#
# Enable Google (and Email) under User & Authentication → Social Connections.
# Add http://localhost:5173 to allowed origins / redirect URLs.
#
# Backend also needs Clerk JWKS + issuer (see backend/.env.example) so
# Authorization: Bearer <session JWT> is accepted on /sessions*.
